{
  "name": "interlint",
  "version": "0.0.0",
  "description": "Deterministic harness that runs a project's existing checks inside an AI coding agent's session.",
  "type": "module",
  "license": "MIT",
  "author": "Raul Garcia",
  "keywords": [
    "ai",
    "coding-agent",
    "archunit",
    "opencode",
    "claude-code",
    "maven",
    "lint"
  ],
  "bin": {
    "interlint": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "integrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
