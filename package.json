{
  "name": "interlint",
  "version": "0.0.0",
  "description": "Deterministic harness that runs a project's existing checks inside an AI coding agent's session.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "interlint": "dist/cli.js"
  },
  "files": [
    "dist",
    "integrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
